# Environment Configuration
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/modsbazaar
MONGODB_URI_PROD=mongodb+srv://username:password@cluster.mongodb.net/modsbazaar

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Redis (for caching and sessions)
REDIS_URL=redis://localhost:6379

# Email Configuration
EMAIL_FROM=noreply@modsbazaar.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=100000000
ALLOWED_FILE_TYPES=.zip,.rar,.7z,.exe,.msi

# Cloudinary (for image hosting)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Payment (Stripe)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Discord Integration
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-url

# Admin
ADMIN_EMAIL=admin@modsbazaar.com
ADMIN_PASSWORD=change-this-super-secure-password

# CORS
FRONTEND_URL=http://localhost:3000
FRONTEND_URL_PROD=https://modsbazaar.vercel.app

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=ModsBazaar is currently under maintenance. We'll be back soon!

# API Keys
API_KEY_HEADER=x-api-key
MASTER_API_KEY=your-master-api-key-for-admin-access
