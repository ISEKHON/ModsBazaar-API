# ModsBazaar Backend - Environment Variables Template
# Copy this file and rename to .env for local development
# For Render deployment, add these in the Render dashboard

# Server Configuration
NODE_ENV=production
PORT=10000

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/modsbazaar?retryWrites=true&w=majority
REDIS_URL=redis://username:password@hostname:port

# JWT Authentication
JWT_SECRET=your-super-secure-jwt-secret-key-here
JWT_EXPIRES_IN=7d

# Email Configuration (for notifications)
EMAIL_FROM=noreply@modsbazaar.com
EMAIL_HOST=smtp.your-email-provider.com
EMAIL_PORT=587
EMAIL_USER=your-email-username
EMAIL_PASS=your-email-password

# Cloudinary (for image storage)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Stripe (for payments)
STRIPE_SECRET_KEY=sk_test_or_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Discord (for notifications - optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-url

# Frontend URLs
FRONTEND_URL_PROD=https://modsbazaar.vercel.app

# API Security
MASTER_API_KEY=your-master-api-key-for-admin-operations

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
DISABLE_RATE_LIMIT=false
